# URL del Backend Laravel API
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Token de Mapbox GL para Zonas de Delivery y Geolocalización de Empresa (Trujillo)
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Tiempo real de notificaciones por SSE (Server-Sent Events).
# Mantener en false con `php artisan serve` (un solo hilo): una conexión SSE
# permanente bloquea todas las demás peticiones y todo el sistema se cuelga.
# Activar solo con servidor multihilo (Laravel Octane / Nginx / Apache).
VITE_ENABLE_SSE=false
